--- /dev/null
+++ b/tests/repro/test_missing_inspector.py
@@ -0,0 +1,15 @@
+"""재현: inspector_id가 없는 record가 있으면 집계가 KeyError로 실패한다."""
+
+from app.defects import summarize
+
+
+def test_missing_inspector_is_counted_as_unassigned():
+    records = [
+        {"defect_id": "D-1", "inspector_id": "I-01"},
+        {"defect_id": "D-2"},
+    ]
+    assert summarize("L3-0927-118", records) == {
+        "lot_id": "L3-0927-118",
+        "total_defects": 2,
+        "by_inspector": {"I-01": 1, "미지정": 1},
+    }
