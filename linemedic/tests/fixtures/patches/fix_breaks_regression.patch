@@ -0,0 +1,9 @@
+"""재현: inspector_id가 없는 record의 건수와 미지정 집계."""
+
+from app.defects import summarize
+
+
+def test_missing_inspector_fields():
+    result = summarize("L3-0927-118", [{"defect_id": "D-1", "inspector_id": "I-01"}, {"defect_id": "D-2"}])
+    assert result["total_defects"] == 2
+    assert result["by_inspector"] == {"I-01": 1, "미지정": 1}
