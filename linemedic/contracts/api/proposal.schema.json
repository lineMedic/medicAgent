{
  "$defs": {
    "CreatePrAction": {
      "additionalProperties": false,
      "properties": {
        "base_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Base Sha",
          "type": "string"
        },
        "diff": {
          "maxLength": 120000,
          "minLength": 1,
          "title": "Diff",
          "type": "string"
        },
        "local_test_observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalTestObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "new_test_path": {
          "pattern": "^tests/repro/test_[A-Za-z0-9_]{1,64}\\.py$",
          "title": "New Test Path",
          "type": "string"
        },
        "root_cause_hypothesis": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Root Cause Hypothesis",
          "type": "string"
        },
        "type": {
          "const": "create_pr",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "base_sha",
        "root_cause_hypothesis",
        "diff",
        "new_test_path"
      ],
      "title": "CreatePrAction",
      "type": "object"
    },
    "EscalateAction": {
      "additionalProperties": false,
      "properties": {
        "missing_requirements": {
          "anyOf": [
            {
              "items": {
                "maxLength": 300,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 10,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Requirements"
        },
        "open_questions": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Open Questions",
          "type": "array"
        },
        "reason": {
          "enum": [
            "UNSUPPORTED_ACTION",
            "INSUFFICIENT_EVIDENCE",
            "CONFLICTING_REQUIREMENTS",
            "PERMISSION_REQUIRED",
            "HUMAN_WORK_IN_PROGRESS",
            "LOOKUP_INCOMPLETE",
            "START_NOTICE_UNCONFIRMED",
            "MODEL_UNAVAILABLE",
            "BUDGET_EXCEEDED",
            "VALIDATION_FAILED",
            "SOURCE_CHANGED",
            "EXTERNAL_RESULT_UNKNOWN",
            "VERIFICATION_FAILED",
            "OBSERVATION_INCONCLUSIVE"
          ],
          "title": "Reason",
          "type": "string"
        },
        "retry_condition": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry Condition"
        },
        "type": {
          "const": "escalate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reason",
        "open_questions"
      ],
      "title": "EscalateAction",
      "type": "object"
    },
    "LocalTestObservation": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "enum": [
            "failed",
            "passed",
            "error",
            "not_run"
          ],
          "title": "After",
          "type": "string"
        },
        "before": {
          "enum": [
            "failed",
            "passed",
            "error",
            "not_run"
          ],
          "title": "Before",
          "type": "string"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "title": "LocalTestObservation",
      "type": "object"
    },
    "WorkOrderDraftAction": {
      "additionalProperties": false,
      "properties": {
        "equipment_id": {
          "pattern": "^[A-Z0-9][A-Z0-9-]{0,31}$",
          "title": "Equipment Id",
          "type": "string"
        },
        "manual_ref_id": {
          "pattern": "^MANUAL-[A-Z0-9][A-Z0-9.-]{0,47}$",
          "title": "Manual Ref Id",
          "type": "string"
        },
        "open_questions": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Open Questions",
          "type": "array"
        },
        "probable_cause": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Probable Cause",
          "type": "string"
        },
        "symptom": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Symptom",
          "type": "string"
        },
        "type": {
          "const": "create_work_order_draft",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "equipment_id",
        "symptom",
        "probable_cause",
        "manual_ref_id",
        "open_questions"
      ],
      "title": "WorkOrderDraftAction",
      "type": "object"
    }
  },
  "$id": "urn:linemedic:v4:proposal",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "category": {
            "const": "code_bug"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "action": {
            "properties": {
              "type": {
                "enum": [
                  "create_pr",
                  "escalate"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "equipment"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "action": {
            "properties": {
              "type": {
                "enum": [
                  "create_work_order_draft",
                  "escalate"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "config"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "action": {
            "properties": {
              "type": {
                "enum": [
                  "escalate"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "infra"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "action": {
            "properties": {
              "type": {
                "enum": [
                  "escalate"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "external_dependency"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "action": {
            "properties": {
              "type": {
                "enum": [
                  "escalate"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "unknown"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "action": {
            "properties": {
              "type": {
                "enum": [
                  "escalate"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "properties": {
              "type": {
                "enum": [
                  "create_pr",
                  "create_work_order_draft"
                ]
              }
            }
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "action": {
      "discriminator": {
        "mapping": {
          "create_pr": "#/$defs/CreatePrAction",
          "create_work_order_draft": "#/$defs/WorkOrderDraftAction",
          "escalate": "#/$defs/EscalateAction"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CreatePrAction"
        },
        {
          "$ref": "#/$defs/WorkOrderDraftAction"
        },
        {
          "$ref": "#/$defs/EscalateAction"
        }
      ],
      "title": "Action"
    },
    "attempt_id": {
      "pattern": "^ATT-[0-9A-F]{12}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "category": {
      "enum": [
        "code_bug",
        "equipment",
        "config",
        "infra",
        "external_dependency",
        "unknown"
      ],
      "title": "Category",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^EV-[0-9A-F]{12}$",
        "type": "string"
      },
      "maxItems": 20,
      "title": "Evidence Ids",
      "type": "array",
      "uniqueItems": true
    },
    "incident_id": {
      "pattern": "^INC-[0-9A-F]{12}$",
      "title": "Incident Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^r-\\d{8}-\\d{6}-[0-9a-f]{4}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "linemedic.v4",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "work_id": {
      "pattern": "^WORK-[0-9A-F]{12}$",
      "title": "Work Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "incident_id",
    "work_id",
    "attempt_id",
    "category",
    "summary",
    "evidence_ids",
    "action"
  ],
  "title": "Proposal",
  "type": "object"
}
