# LineMedic v4 환경 변수 이름 (spec/docs/11-runbook.md §2).
# 값은 비워 둔다. 실제 값은 .env에 사람이 직접 넣고, 대화·문서·커밋에 붙여 넣지 않는다.
# agent·runner·MES에는 이 파일 전체를 넘기지 않고 필요한 최소 변수만 전달한다.

LINE_MEDIC_ENV=
AGENT_MODE=
AGENT_RUNTIME=
NVIDIA_MODEL_ID=
NVIDIA_BASE_URL=
NVIDIA_API_KEY=  # secret
GITHUB_REPOSITORY=
GITHUB_REPOSITORY_ID=
ISSUE_INTAKE_ENABLED=
ISSUE_POLL_SECONDS=
ISSUE_TRUSTED_AUTHOR_IDS=
ROUTING_SCOPE=
NOTIFICATION_ROUTE_ID=
LINEMEDIC_OPS_RECIPIENT=  # secret (SMTP 선택 시만)
SMTP_CREDENTIAL=  # secret (SMTP 선택 시만)
MEMORY_MODE=
MEMORY_SNAPSHOT_PATH=
CASE_SEARCH_ENGINE=
GITHUB_BROKER_CREDENTIAL=  # secret
GITHUB_SETUP_CREDENTIAL=  # secret
DEMO_HOST_ID=
CONTROL_AGENT_TOKEN=  # secret
CONTROL_OPERATOR_TOKEN=  # secret
BASELINE_COMMIT=
RUNNER_IMAGE_ID=
MES_BASE_IMAGE_ID=
RUNS_DIR=
